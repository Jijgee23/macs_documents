generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Module {
  id       String    @id @default(cuid())
  title    String
  order    Int
  sections Section[]
}

model Section {
  id        String   @id
  title     String
  body      String?
  order     Int
  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Section? @relation("SectionChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  Section[] @relation("SectionChildren")
  updatedAt DateTime @updatedAt

  @@index([moduleId])
  @@index([parentId])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Settings {
  id                 String   @id @default("singleton")
  chatModel          String   @default("claude-opus-5")
  systemPrompt       String?
  rules              String?
  unavailableMessage String?
  errorMessage       String?
  updatedAt          DateTime @updatedAt
}

/** Follow-up state for inquiries submitted from macs.mn. */
enum RequestStatus {
  NEW
  CONTACTED
  CLOSED
}

/** Price-quote request from macs.mn/une-sanal (POST /api/site/quote). */
model QuoteRequest {
  id        String        @id @default(cuid())
  name      String?
  company   String?
  email     String
  phone     String
  /** Ids from QUOTE_PRODUCTS in lib/inquiries.ts */
  products  String[]
  message   String?
  status    RequestStatus @default(NEW)
  note      String?
  /** Site language the request came from: "mn" | "en" */
  locale    String        @default("mn")
  ip        String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([ip, createdAt])
}

/** General contact message from macs.mn/holboo-barih (POST /api/site/contact). */
model ContactMessage {
  id        String        @id @default(cuid())
  name      String?
  email     String
  phone     String?
  /** One of CONTACT_TOPICS in lib/inquiries.ts */
  topic     String
  message   String
  status    RequestStatus @default(NEW)
  note      String?
  /** Site language the message came from: "mn" | "en" */
  locale    String        @default("mn")
  ip        String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([ip, createdAt])
}
